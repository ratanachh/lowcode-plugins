{
  "name": "@rchh/lowcode-plugin-components-pane",
  "version": "2.0.6",
  "description": "Lowcode components pane",
  "files": [
    "es/",
    "lib/"
  ],
  "main": "lib/index.js",
  "module": "es/index.js",
  "stylePath": "style.js",
  "scripts": {
    "start": "NODE_OPTIONS='--openssl-legacy-provider --no-experimental-strip-types' build-scripts start",
    "build": "NODE_OPTIONS='--openssl-legacy-provider --no-experimental-strip-types' build-scripts build --skip-demo",
    "f2elint-scan": "f2elint scan",
    "f2elint-fix": "f2elint fix",
    "prepublishOnly": "npm run build && npm run postbuild",
    "postbuild": "node ./scripts/copy-icon-assets.js"
  },
  "keywords": [
    "lowcode",
    "plugin",
    "components"
  ],
  "authors": [
    {
      "name": "gray.wjf"
    },
    {
      "name": "Jinchan"
    }
  ],
  "license": "ISC",
  "devDependencies": {
    "@alib/build-scripts": "^0.1.32",
    "@alifd/next": "^1.23.12",
    "@rchh/build-plugin-alt": "^1.3.4",
    "@svgr/webpack": "^5.5.0",
    "@types/react": "^16.9.13",
    "@types/react-dom": "^16.9.4",
    "@typescript-eslint/parser": "^4.28.3",
    "build-plugin-component": "^1.12.0",
    "build-plugin-fusion": "^0.1.0",
    "build-plugin-moment-locales": "^0.1.0",
    "eventemitter3": "^4.0.7",
    "f2elint": "^1.2.0",
    "html-webpack-plugin": "^5.3.2",
    "moment": "^2.29.1",
    "react-dom": "^16.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "f2elint commit-file-scan",
      "commit-msg": "f2elint commit-msg-scan"
    }
  },
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@rchh/lowcode-editor-core": "^1.3.4",
    "@rchh/lowcode-types": "^1.3.4",
    "classnames": "^2.3.1",
    "lodash.debounce": "^4.0.8",
    "react": "^16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ratanachh/lowcode-plugins.git",
    "directory": "packages/plugin-components-pane"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://ratanachh.github.io/lowcode-engine/",
  "bugs": "https://github.com/ratanachh/lowcode-plugins/issues"
}
